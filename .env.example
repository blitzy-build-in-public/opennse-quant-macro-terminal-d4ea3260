# OpenNSE Quant & Macro Terminal: environment template.
#
# Copy to .env in the repository root (cp .env.example .env) and run every command from there.
# .env is git-ignored; never commit it. The values below are development defaults that match the
# postgres service in docker-compose.yml.
#
# One .env serves both halves of the project:
# - the backend reads TERMINAL_* through TerminalSettings (pydantic-settings), and ignores the
#   keys that are not settings fields (TERMINAL_TEST_DATABASE_URL, TERMINAL_API_ORIGIN);
# - Next.js loads it at next dev / next build. No name here starts with NEXT_PUBLIC_, so none of
#   these values is ever embedded in the browser bundle.
# A variable set in the process environment takes precedence over this file in both.
#
# Every data source is public, so no API key, token or other secret is required.
# Keep comments on their own lines and values unquoted: both dotenv readers parse that form alike.

# ---------------------------------------------------------------------------------------------
# Backend: TerminalSettings (backend/opennse_terminal/config.py)
# ---------------------------------------------------------------------------------------------

# SQLAlchemy async URL (asyncpg driver required). Also used by migrations, the seeder,
# the ingestion CLI and the scheduler process. opennse/opennse are the throwaway credentials of
# the development container, not a secret; any other deployment sets its own URL.
TERMINAL_DATABASE_URL=postgresql+asyncpg://opennse:opennse@localhost:5432/opennse

# Subject of the default principal when no host authentication is injected, and owner of the
# seeded watchlist. An opaque identifier, not a credential.
TERMINAL_DEFAULT_OWNER_KEY=local

# Exchange and scheduler timezone (IANA name; Africa/Nairobi is UTC+3 with no daylight saving).
TERMINAL_TIMEZONE=Africa/Nairobi

# Days after period_end_date before a fundamentals row is treated as published.
TERMINAL_FUNDAMENTALS_LAG_DAYS=90

# Set a real contact address: scrapers identify themselves with the user agent
# OpenNSE-Terminal/<version> (+mailto:<this address>). It must be local@domain in visible ASCII,
# with no spaces or control characters.
TERMINAL_SCRAPER_CONTACT=ops@example.invalid

# Minimum spacing between requests to the same host, in seconds.
TERMINAL_SCRAPER_MIN_INTERVAL_SECONDS=2.0

# Read timeout per request, in seconds (the connect timeout is fixed at 10 s).
TERMINAL_SCRAPER_TIMEOUT_SECONDS=30

# Retries on timeouts and HTTP 429/500/502/503/504.
TERMINAL_SCRAPER_MAX_RETRIES=3

# POST /ingest/pdf: per-file limit in bytes (20 MiB), at most 1073741824 (1 GiB). The whole
# request may carry 1 MiB more.
TERMINAL_PDF_MAX_BYTES=20971520

# POST /ingest/pdf: maximum pages parsed per file.
TERMINAL_PDF_MAX_PAGES=400

# POST /ingest/pdf: concurrent parses per API process, 1-32; further requests receive 429.
TERMINAL_PDF_MAX_CONCURRENCY=2

# ---------------------------------------------------------------------------------------------
# Tests: backend integration suite
# ---------------------------------------------------------------------------------------------

# Administrative connection only. The suite creates and drops its own template and clone
# databases on this server, so its role needs CREATEDB. opennse_test is created by
# docker/postgres-init.sql on first start of the compose volume.
TERMINAL_TEST_DATABASE_URL=postgresql+asyncpg://opennse:opennse@localhost:5432/opennse_test

# ---------------------------------------------------------------------------------------------
# Frontend: Next.js and Playwright
# ---------------------------------------------------------------------------------------------

# Origin of the FastAPI app that serves /api/v1/terminal/*; next.config.ts rewrites the
# browser's same-origin calls there. Rewrites are fixed at next build, so rebuild after
# changing it. playwright.config.ts resolves it as next build does: from the process
# environment or, failing that, from the env files (.env.production.local, .env.local,
# .env.production, this file; with NODE_ENV=test .env.test.local, .env.test, this file), with
# $VAR references expanded. It forwards that one value to both servers it starts: the
# standalone app and the host fixture, which does not read the root .env itself. The
# Playwright run and the host fixture accept only a loopback origin (localhost, 127.0.0.0/8
# or [::1], any port) without userinfo, a query or a fragment: otherwise Playwright stops
# before starting either server, and the fixture exits when it loads its config. The
# standalone next.config.ts still accepts remote origins.
TERMINAL_API_ORIGIN=http://localhost:8000

# CI is deliberately not set here: playwright.config.ts reads it from the process environment
# only, so set it per run (CI=true npm run test:e2e) and leave it unset for local work. When
# set, failing tests are retried twice, a leftover test.only fails the run (forbidOnly), and a
# server already listening on :3000 or :3100 is an error rather than reused
# (reuseExistingServer). Any non-empty value counts as set, including "false" and "0".
