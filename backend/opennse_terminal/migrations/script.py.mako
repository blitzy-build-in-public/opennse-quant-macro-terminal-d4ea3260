## Revision template of the terminal's isolated Alembic history (terminal_alembic_version).
## Lines starting with "##" are Mako comments: they never appear in a generated revision.
##
## Conventions for every revision rendered from this template:
## - Generate it with rev_id="terminal_000N", the next number in the sequence, for example
##   alembic.command.revision(build_alembic_config(url), message="add x", rev_id="terminal_0002",
##   autogenerate=True). Alembic's default file_template then writes
##   versions/terminal_0002_add_x.py.
## - Schema isolation (Rule 3): every table it creates is named terminal_*, and every index and
##   constraint takes the op.f(...) name produced by the TerminalBase naming convention, so each
##   name contains "terminal_". It never creates users, auth or other host-generic tables, and
##   never alters an object whose name lacks the prefix.
## - Financial accuracy (Rule 4): money and ratio columns are sa.Numeric(precision, scale), read
##   as Decimal, never Float; currency columns are CHAR(3) defaulting to 'KES'.
## - Never import ORM models or other opennse_terminal code into a revision. A revision is a
##   frozen snapshot of the schema and must keep working after the models change.
##
## The bare render passes ruff check, ruff format --check and mypy --strict, which is why:
## - identifiers are written by py_literal as double-quoted literals instead of repr();
## - the autogenerate imports block is a control line, so an empty one adds no blank line;
## - "Revises:" takes its space only when there is a down revision, so a base revision's
##   docstring has no trailing whitespace;
## - sa and op carry noqa: F401, because an empty revision uses neither.
## Alembic renders autogenerated operations in single quotes, unwrapped, so run ruff format and
## ruff check --fix on a new autogenerated revision, then split what they cannot (such as a long
## CHECK constraint string), before committing it.
##
## The trailing backslash after the module block below consumes its newline, so the rendered
## file starts with the docstring.
<%!
import json


def py_literal(value):
    """Render a revision identifier value as the Python literal ruff format would write.

    Alembic passes None, a str, a tuple of str (merge heads, branch labels) or a list of str
    (several depends_on revisions). json.dumps writes a double-quoted, correctly escaped string
    that is also a valid Python literal.
    """
    if value is None:
        return "None"
    if isinstance(value, str):
        return json.dumps(value)
    items = ", ".join(py_literal(item) for item in value)
    if isinstance(value, list):
        return "[" + items + "]"
    return "(" + items + ("," if len(value) == 1 else "") + ")"
%>\
"""${message}

Revision ID: ${up_revision}
Revises:${(" " + comma(down_revision)) if down_revision is not None else ""}
Create Date: ${create_date}

"""

from collections.abc import Sequence

import sqlalchemy as sa  # noqa: F401
from alembic import op  # noqa: F401
% if imports:
${imports}
% endif

# revision identifiers, used by Alembic.
revision: str = ${py_literal(up_revision)}
down_revision: str | Sequence[str] | None = ${py_literal(down_revision)}
branch_labels: str | Sequence[str] | None = ${py_literal(branch_labels)}
depends_on: str | Sequence[str] | None = ${py_literal(depends_on)}


def upgrade() -> None:
    """Apply this revision's schema changes; touch only ``terminal_``-prefixed objects."""
    ${upgrades if upgrades else "pass"}


def downgrade() -> None:
    """Reverse exactly what ``upgrade()`` changed, in reverse order; never touch
    non-``terminal_`` objects.
    """
    ${downgrades if downgrades else "pass"}
